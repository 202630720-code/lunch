zip_filename = "Unity_FPS_Lightsaber_Scripts.zip"
with zipfile.ZipFile(zip_filename, "w") as zf:
    for name, content in scripts.items():
        zf.writestr(f"Scripts/{name}", content)

print(f"ZIP File created: {zip_filename}")
